{
    "name": "ventasfix/microservicio-carro-compra",
    "type": "project",
    "description": "Microservicio de Manejo de Carro de Compra - VentasFix (Backoffice + API)",
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "abandoned": "ignore"
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
